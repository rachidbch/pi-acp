{
  "name": "@razorbackdb/pi-acp",
  "version": "0.0.36",
  "description": "ACP adapter for the pi coding agent, forked from svkozak/pi-acp: client MCP servers, extension slash commands, elicitation for extension input/editor prompts, structured tool results.",
  "license": "MIT",
  "author": "Sergii Kozak <svkozak@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razorbackdb/pi-acp.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/razorbackdb/pi-acp/issues"
  },
  "homepage": "https://github.com/razorbackdb/pi-acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "pi-coding-agent",
    "adapter",
    "mcp",
    "zed",
    "jetbrains"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-acp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke": "node scripts/smoke-acp.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.1",
    "cross-spawn": "^7.0.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "acpx": "0.20.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.8.3",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0"
  }
}
